# Theme: Neon Arena
# A high-contrast cyber-gaming palette for Omarchy

# Main bg
theme[main_bg]="#090B14"

# Main text color
theme[main_fg]="#D7E2FF"

# Title color for boxes
theme[title]="#00E5FF"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#C77DFF"

# Background color of selected item in processes box
theme[selected_bg]="#1B2138"

# Foreground color of selected item in processes box
theme[selected_fg]="#F5F7FF"

# Color of inactive/disabled text
theme[inactive_fg]="#45506E"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#54C7FF"

# Cpu box outline color
theme[cpu_box]="#00E5FF"

# Memory/disks box outline color
theme[mem_box]="#C77DFF"

# Net up/down box outline color
theme[net_box]="#3DFFB5"

# Processes box outline color
theme[proc_box]="#FF3D81"

# Box divider line and small boxes line color
theme[div_line]="#45506E"

# Temperature graph colors
theme[temp_start]="#3DFFB5"
theme[temp_mid]="#FFD166"
theme[temp_end]="#FF3D81"

# CPU graph colors
theme[cpu_start]="#00E5FF"
theme[cpu_mid]="#C77DFF"
theme[cpu_end]="#FF3D81"

# Mem/Disk free meter
theme[free_start]="#3DFFB5"
theme[free_mid]="#00E5FF"
theme[free_end]="#C77DFF"

# Mem/Disk cached meter
theme[cached_start]="#00E5FF"
theme[cached_mid]="#54C7FF"
theme[cached_end]="#C77DFF"

# Mem/Disk available meter
theme[available_start]="#3DFFB5"
theme[available_mid]="#00E5FF"
theme[available_end]="#C77DFF"

# Mem/Disk used meter
theme[used_start]="#FFD166"
theme[used_mid]="#FF6BA6"
theme[used_end]="#FF3D81"

# Download graph colors
theme[download_start]="#00E5FF"
theme[download_mid]="#54C7FF"
theme[download_end]="#C77DFF"

# Upload graph colors
theme[upload_start]="#C77DFF"
theme[upload_mid]="#FF6BA6"
theme[upload_end]="#FF3D81"
